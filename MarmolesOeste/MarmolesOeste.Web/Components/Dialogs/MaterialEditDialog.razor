@inject IDbContextFactory<ApplicationDbContext> DbFactory

<MudDialog>
    <TitleContent>@(MaterialId == 0 ? "Nuevo material" : "Editar material")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Nombre" Label="Nombre" Required="true" RequiredError="El nombre es obligatorio" Class="mb-2" />
            <MudSelect T="TipoMaterial" @bind-Value="_model.Tipo" Label="Tipo" Required="true" Class="mb-2">
                @foreach (var tipo in Enum.GetValues<TipoMaterial>())
                {
                    <MudSelectItem T="TipoMaterial" Value="@tipo">@tipo</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField @bind-Value="_model.Espesor" Label="Espesor (cm)" Required="true" Min="0.1m" Format="N1" Class="mb-2" />
            <MudNumericField @bind-Value="_model.PrecioPorM2" Label="Precio por m²" Required="true" Min="0m" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-2" />
            <MudNumericField @bind-Value="_model.PrecioPorMetroLinealZocalo" Label="Precio por metro lineal de zócalo" Required="true" Min="0m" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Class="mb-2" />
            <MudTextField @bind-Value="_model.ImagenUrl" Label="URL de imagen (opcional)" Class="mb-2" />

            <MudText Typo="Typo.body2" Class="mb-1">Color en el dibujo del presupuesto</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
                <input type="color" @bind="_model.ColorHex" @bind:event="oninput" style="width:56px;height:36px;border:none;border-radius:4px;cursor:pointer;padding:0" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_model.ColorHex</MudText>
            </MudStack>

            @if (MaterialId != 0)
            {
                @if (_model.FechaUltimaActualizacion is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                        Última actualización: @_model.FechaUltimaActualizacion.Value.ToLocalTime().ToString("dd/MM/yyyy") — @_model.MotivoUltimaActualizacion
                    </MudText>
                }
                <MudTextField @bind-Value="_motivoCambio" Label="Motivo de este cambio" Required="true"
                              RequiredError="Contá brevemente por qué cambiás esto" Lines="2" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int MaterialId { get; set; }

    private MudForm _form = null!;
    private Material _model = new();
    private string _motivoCambio = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (MaterialId == 0)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Materiales.FindAsync(MaterialId);
        if (existing is not null)
        {
            _model = new Material
            {
                Id = existing.Id,
                Nombre = existing.Nombre,
                Tipo = existing.Tipo,
                Espesor = existing.Espesor,
                PrecioPorM2 = existing.PrecioPorM2,
                PrecioPorMetroLinealZocalo = existing.PrecioPorMetroLinealZocalo,
                ImagenUrl = existing.ImagenUrl,
                ColorHex = existing.ColorHex,
                FechaUltimaActualizacion = existing.FechaUltimaActualizacion,
                MotivoUltimaActualizacion = existing.MotivoUltimaActualizacion,
            };
        }
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (MaterialId == 0)
        {
            db.Materiales.Add(new Material
            {
                Nombre = _model.Nombre,
                Tipo = _model.Tipo,
                Espesor = _model.Espesor,
                PrecioPorM2 = _model.PrecioPorM2,
                PrecioPorMetroLinealZocalo = _model.PrecioPorMetroLinealZocalo,
                ImagenUrl = _model.ImagenUrl,
                ColorHex = _model.ColorHex,
            });
        }
        else
        {
            var existing = await db.Materiales.FindAsync(MaterialId);
            if (existing is not null)
            {
                existing.Nombre = _model.Nombre;
                existing.Tipo = _model.Tipo;
                existing.Espesor = _model.Espesor;
                existing.PrecioPorM2 = _model.PrecioPorM2;
                existing.PrecioPorMetroLinealZocalo = _model.PrecioPorMetroLinealZocalo;
                existing.ImagenUrl = _model.ImagenUrl;
                existing.ColorHex = _model.ColorHex;
                existing.FechaUltimaActualizacion = DateTime.UtcNow;
                existing.MotivoUltimaActualizacion = _motivoCambio;
            }
        }

        await db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
